<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_pink"
    android:padding="16dp">

    <TextView style="@style/PinkTitle" android:text="应用详情"/>

    <View
        android:layout_width="60dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/title_line"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/et_app_pkg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="输包名，或者点下面按钮选"
        android:background="@color/white"
        android:padding="10dp"
        android:singleLine="true"
        android:layout_marginBottom="8dp"/>

    <Button android:id="@+id/btn_app_detail_pick" android:text="从已装应用选"
        style="@style/WhiteBtn"/>

    <Button android:id="@+id/btn_app_detail_do" android:text="查详情"
        style="@style/WhiteBtn"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/tv_app_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textIsSelectable="true"/>

    </ScrollView>

</LinearLayout>