<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/PinkTitle" android:text="@string/title_aes_tool"/>

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/title_line"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/et_aes_input"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top|start"
            android:background="@color/white"
            android:padding="10dp"
            android:inputType="textMultiLine"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/et_aes_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="10dp"
            android:singleLine="true"
            android:inputType="textPassword"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/btn_aes_encrypt" android:text="@string/file_enc_do"
                style="@style/WhiteBtn"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginEnd="4dp"/>

            <Button android:id="@+id/btn_aes_decrypt" android:text="@string/file_enc_dec"
                style="@style/WhiteBtn"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="4dp" android:layout_marginEnd="4dp"/>

            <Button android:id="@+id/btn_aes_clear" android:text="@string/file_del_cancel"
                style="@style/WhiteBtn"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_aes_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="120dp"
            android:background="@color/white"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textIsSelectable="true"
            android:typeface="monospace"/>
    </LinearLayout>
</ScrollView>