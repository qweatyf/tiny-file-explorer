<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_pink"
    android:padding="20dp">

    <TextView style="@style/PinkTitle" android:text="@string/mine_title"/>

    <View
        android:layout_width="60dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/title_line"
        android:layout_marginBottom="30dp"/>

    <Button android:id="@+id/btn_user" android:text="@string/btn_user" style="@style/WhiteBtn"/>
    <Button android:id="@+id/btn_account" android:text="@string/btn_account" style="@style/WhiteBtn"/>
    <Button android:id="@+id/btn_memo" android:text="@string/btn_memo" style="@style/WhiteBtn"/>
    <Button android:id="@+id/btn_vault" android:text="@string/btn_vault" style="@style/WhiteBtn"/>
    <Button android:id="@+id/btn_mine_account_book" android:text="@string/btn_mine_account_book" style="@style/WhiteBtn"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <Button android:id="@+id/btn_logout" android:text="@string/btn_logout" style="@style/DangerBtn"/>

</LinearLayout>