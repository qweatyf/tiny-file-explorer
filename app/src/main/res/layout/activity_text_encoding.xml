<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/PinkTitle" android:text="文本编码转换"/>

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/title_line"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/et_enc_input"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="输文字，或者选文件"
            android:gravity="top|start"
            android:background="@color/white"
            android:padding="10dp"
            android:inputType="textMultiLine"/>

        <Button android:id="@+id/btn_enc_pick" android:text="选文件" style="@style/WhiteBtn"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_enc_to_utf8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="转 UTF-8"
                style="@style/WhiteBtn"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btn_enc_to_gbk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="转 GBK"
                style="@style/WhiteBtn"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btn_enc_to_unicode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="转 Unicode"
                style="@style/WhiteBtn"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_enc_output"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:minHeight="200dp"
            android:background="@color/white"
            android:padding="12dp"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textIsSelectable="true"/>

    </LinearLayout>
</ScrollView>