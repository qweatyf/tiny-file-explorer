<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_pink"
    android:padding="20dp">

    <TextView style="@style/PinkTitle" android:text="@string/title_net_toolbox"/>

    <View
        android:layout_width="60dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/title_line"
        android:layout_marginBottom="20dp"/>

    <Button android:id="@+id/btn_net_http" android:text="@string/title_http_request" style="@style/WhiteBtn"/>
    <Button android:id="@+id/btn_net_lan" android:text="@string/title_lan_scan" style="@style/WhiteBtn"/>
    <Button android:id="@+id/btn_net_port" android:text="@string/title_port_scan" style="@style/WhiteBtn"/>
    <Button android:id="@+id/btn_net_speed" android:text="@string/title_speed_test" style="@style/WhiteBtn"/>

</LinearLayout>