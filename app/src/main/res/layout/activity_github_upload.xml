<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/PinkTitle"
            android:text="@string/github_title"/>

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/title_line"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/et_gh_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/github_token_hint"
            android:inputType="textPassword"
            android:background="@color/white"
            android:padding="10dp"
            android:singleLine="true"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tv_gh_token_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#888888"
            android:paddingBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_gh_check"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/github_check"
                style="@style/WhiteBtn"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btn_gh_clear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/github_clear"
                style="@style/WhiteBtn"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

        <EditText
            android:id="@+id/et_gh_owner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/github_owner_hint"
            android:background="@color/white"
            android:padding="10dp"
            android:singleLine="true"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/et_gh_repo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/github_repo_hint"
            android:background="@color/white"
            android:padding="10dp"
            android:singleLine="true"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/et_gh_branch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/github_branch_hint"
            android:text="main"
            android:background="@color/white"
            android:padding="10dp"
            android:singleLine="true"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/et_gh_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/github_msg_hint"
            android:text="update"
            android:background="@color/white"
            android:padding="10dp"
            android:singleLine="true"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/et_gh_dir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/github_dir_hint"
            android:background="@color/white"
            android:padding="10dp"
            android:singleLine="true"
            android:inputType="textUri"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/et_gh_exclude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/github_exclude_hint"
            android:background="@color/white"
            android:padding="10dp"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top|start"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_gh_pick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/github_pick_dir"
                style="@style/WhiteBtn"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btn_gh_upload"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/github_upload"
                style="@style/WhiteBtn"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/pb_gh"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/tv_gh_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="120dp"
            android:background="@color/white"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:typeface="monospace"/>

    </LinearLayout>
</ScrollView>