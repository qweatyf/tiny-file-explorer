<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_pink"
    android:padding="20dp">

    <TextView style="@style/PinkTitle" android:text="音频信息"/>

    <View
        android:layout_width="60dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/title_line"
        android:layout_marginBottom="20dp"/>

    <Button android:id="@+id/btn_ai_pick" android:text="选音频" style="@style/WhiteBtn"/>

    <TextView
        android:id="@+id/tv_ai_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="未选"
        android:textColor="@color/text"
        android:padding="10dp"
        android:ellipsize="middle"
        android:singleLine="true"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:text="选完立刻弹信息框"
        android:textSize="12sp"
        android:textColor="#888"
        android:gravity="center"/>

</LinearLayout>