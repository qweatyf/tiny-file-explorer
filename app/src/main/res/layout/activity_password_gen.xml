<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/PinkTitle" android:text="随机密码生成"/>

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/title_line"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="长度:" android:textColor="@color/text" android:textSize="15sp"/>

            <EditText
                android:id="@+id/et_pass_len"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:background="@color/white"
                android:padding="10dp"
                android:layout_marginStart="8dp"
                android:singleLine="true"/>

        </LinearLayout>

        <SeekBar
            android:id="@+id/sb_pass_len"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tv_pass_len"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="16"
            android:textSize="12sp"
            android:textColor="#888"
            android:gravity="end"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="包含字符" android:textColor="@color/text"
            android:paddingTop="12dp" android:paddingBottom="4dp"/>

        <CheckBox android:id="@+id/cb_pass_upper" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="大写字母 A-Z"
            android:textColor="@color/text"/>

        <CheckBox android:id="@+id/cb_pass_lower" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="小写字母 a-z"
            android:textColor="@color/text"/>

        <CheckBox android:id="@+id/cb_pass_digit" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="数字 0-9"
            android:textColor="@color/text"/>

        <CheckBox android:id="@+id/cb_pass_symbol" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="特殊符号"
            android:textColor="@color/text"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button android:id="@+id/btn_pass_gen" android:text="生成"
                style="@style/WhiteBtn"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginEnd="4dp"/>

            <Button android:id="@+id/btn_pass_copy" android:text="复制"
                style="@style/WhiteBtn"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_pass_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:background="@color/white"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:textColor="@color/main_pink"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textIsSelectable="true"
            android:typeface="monospace"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>