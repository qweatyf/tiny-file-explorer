<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/PinkTitle" android:text="服务器设置"/>

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/title_line"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="服务器地址（留空 = 本地模式）"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:paddingBottom="4dp"/>

        <EditText
            android:id="@+id/et_settings_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://example.com:8080"
            android:background="@color/white"
            android:padding="10dp"
            android:singleLine="true"
            android:inputType="textUri"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Token（可选，填了会带上 Authorization 头）"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:paddingBottom="4dp"/>

        <EditText
            android:id="@+id/et_settings_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="留空就不带"
            android:background="@color/white"
            android:padding="10dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_settings_save"
                android:text="保存"
                style="@style/WhiteBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btn_settings_test"
                android:text="测试连接"
                style="@style/WhiteBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_settings_clear"
            android:text="清空（切回本地模式）"
            style="@style/WhiteBtn"/>

        <TextView
            android:id="@+id/tv_settings_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:background="@color/white"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textIsSelectable="true"
            android:typeface="monospace"
            android:hint="测试结果会显示在这里"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="本地模式 = 现在的局域网直连\n服务器模式 = 所有联网功能走你填的地址"
            android:textSize="12sp"
            android:textColor="#888"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>