<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView style="@style/PinkTitle" android:text="合成 GIF"/>

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/title_line"
            android:layout_marginBottom="20dp"/>

        <Button android:id="@+id/btn_gif_pick" android:text="选图片 / 视频" style="@style/WhiteBtn"/>

        <TextView
            android:id="@+id/tv_gif_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="未选"
            android:textColor="@color/text"
            android:padding="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="帧间隔 (毫秒)"
            android:textColor="@color/text"
            android:paddingTop="10dp"/>

        <EditText
            android:id="@+id/et_gif_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:background="@color/white"
            android:padding="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="循环次数 (0 = 无限)"
            android:textColor="@color/text"
            android:paddingTop="10dp"/>

        <EditText
            android:id="@+id/et_gif_loop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:background="@color/white"
            android:padding="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="尺寸（宽 × 高，填 0 = 按第一张图）"
            android:textColor="@color/text"
            android:paddingTop="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_gif_w"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:background="@color/white"
                android:padding="10dp"
                android:hint="宽"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" × "
                android:textColor="@color/text"
                android:gravity="center"/>

            <EditText
                android:id="@+id/et_gif_h"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:background="@color/white"
                android:padding="10dp"
                android:hint="高"/>

        </LinearLayout>

        <Button
            android:id="@+id/btn_gif_make"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="合成 GIF"
            style="@style/WhiteBtn"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="图片多选按顺序，视频抽帧会慢\n当前版本只出灰度 GIF"
            android:textSize="12sp"
            android:textColor="#B71C1C"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>