<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView style="@style/PinkTitle" android:text="@string/title_gif_make"/>

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/title_line"
            android:layout_marginBottom="20dp"/>

        <Button android:id="@+id/btn_gif_pick" android:text="@string/file_enc_pick" style="@style/WhiteBtn"/>

        <TextView
            android:id="@+id/tv_gif_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/file_enc_none"
            android:textColor="@color/text"
            android:padding="10dp"/>

        <EditText
            android:id="@+id/et_gif_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:background="@color/white"
            android:padding="10dp"
            android:hint="@string/lang_title"/>

        <EditText
            android:id="@+id/et_gif_loop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:background="@color/white"
            android:padding="10dp"
            android:layout_marginTop="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <EditText
                android:id="@+id/et_gif_w"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:background="@color/white"
                android:padding="10dp"
                android:hint="@string/lang_title"/>

            <EditText
                android:id="@+id/et_gif_h"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:background="@color/white"
                android:padding="10dp"
                android:layout_marginStart="6dp"
                android:hint="@string/lang_title"/>

        </LinearLayout>

        <Button
            android:id="@+id/btn_gif_make"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/img_tool_gif_make"
            style="@style/WhiteBtn"
            android:layout_marginTop="20dp"/>

    </LinearLayout>
</ScrollView>