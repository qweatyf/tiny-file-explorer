<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_pink"
    android:gravity="center"
    android:padding="20dp">

    <TextView style="@style/PinkTitle" android:text="钟表"/>

    <View
        android:layout_width="60dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/title_line"
        android:layout_marginBottom="40dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="40dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textSize="56sp"
            android:textStyle="bold"
            android:textColor="@color/main_pink"
            android:typeface="monospace"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tv_clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0000-00-00"
            android:textSize="18sp"
            android:textColor="@color/text"
            android:paddingTop="20dp"
            android:typeface="monospace"/>

        <TextView
            android:id="@+id/tv_clock_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="星期一"
            android:textSize="16sp"
            android:textColor="#888"
            android:paddingTop="8dp"/>

    </LinearLayout>

</LinearLayout>