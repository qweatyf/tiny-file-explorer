<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/PinkTitle" android:text="定时闹钟"/>

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/title_line"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tv_ac_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="30dp"
            android:text="07:00"
            android:textSize="64sp"
            android:textStyle="bold"
            android:textColor="@color/main_pink"
            android:typeface="monospace"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/et_ac_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="闹钟名字，如 起床"
            android:background="@color/white"
            android:padding="10dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tv_ac_ring_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:background="@color/white"
            android:ellipsize="middle"
            android:singleLine="true"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button android:id="@+id/btn_ac_pick_ring" android:text="选铃声"
                style="@style/WhiteBtn"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginEnd="4dp"/>

            <Button android:id="@+id/btn_ac_reset_ring" android:text="默认铃声"
                style="@style/WhiteBtn"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btn_ac_set"
            android:text="设定闹钟"
            style="@style/WhiteBtn"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="点上面的大数字改时间\n到点会响铃+通知，后台也生效"
            android:textSize="12sp"
            android:textColor="#888"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>