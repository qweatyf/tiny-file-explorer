<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_pink"
    android:padding="20dp">

    <TextView style="@style/PinkTitle" android:text="@string/img_tool_title"/>

    <View
        android:layout_width="60dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/title_line"
        android:layout_marginBottom="20dp"/>

    <Button android:id="@+id/btn_img_compress" android:text="@string/img_tool_compress" style="@style/WhiteBtn"/>
    <Button android:id="@+id/btn_img_format" android:text="@string/img_tool_format" style="@style/WhiteBtn"/>
    <Button android:id="@+id/btn_img_watermark" android:text="@string/img_tool_watermark" style="@style/WhiteBtn"/>
    <Button android:id="@+id/btn_img_color" android:text="@string/img_tool_color" style="@style/WhiteBtn"/>
    <Button android:id="@+id/btn_gif_make" android:text="@string/img_tool_gif_make" style="@style/WhiteBtn"/>
    <Button android:id="@+id/btn_gif_decode" android:text="@string/img_tool_gif_decode" style="@style/WhiteBtn"/>

</LinearLayout>