<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_pink">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView style="@style/PinkTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_media"/>

        <Button
            android:id="@+id/btn_pick_media"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/file_enc_pick"
            style="@style/WhiteBtn"
            android:layout_marginBottom="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <VideoView
            android:id="@+id/vv_media"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"/>

        <LinearLayout
            android:id="@+id/audio_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="20dp">

            <ImageView
                android:id="@+id/iv_media_cover"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:background="#222222"/>

            <TextView
                android:id="@+id/tv_media_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:singleLine="true"
                android:ellipsize="middle"/>

            <TextView
                android:id="@+id/tv_media_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:ellipsize="middle"/>

            <TextView
                android:id="@+id/tv_media_lyric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFD87093"
                android:textSize="15sp"
                android:layout_marginTop="20dp"
                android:minLines="1"
                android:maxLines="2"
                android:ellipsize="end"/>

        </LinearLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/tv_media_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text"
        android:textSize="13sp"
        android:paddingTop="8dp"
        android:text="00:00 / 00:00"/>

    <SeekBar
        android:id="@+id/sb_media_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp">

        <Button
            android:id="@+id/btn_media_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/media_play"
            style="@style/WhiteBtn"
            android:layout_marginBottom="0dp"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/speed_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <Button android:id="@+id/btn_05" android:text="0.5x" style="@style/WhiteBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginEnd="4dp" android:layout_marginBottom="0dp"/>
        <Button android:id="@+id/btn_075" android:text="0.75x" style="@style/WhiteBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginEnd="4dp" android:layout_marginBottom="0dp"/>
        <Button android:id="@+id/btn_1" android:text="1x" style="@style/WhiteBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginEnd="4dp" android:layout_marginBottom="0dp"/>
        <Button android:id="@+id/btn_15" android:text="1.5x" style="@style/WhiteBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginEnd="4dp" android:layout_marginBottom="0dp"/>
        <Button android:id="@+id/btn_2" android:text="2x" style="@style/WhiteBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginBottom="0dp"/>

    </LinearLayout>

</LinearLayout>