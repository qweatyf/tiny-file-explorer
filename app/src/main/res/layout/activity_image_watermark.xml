<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView style="@style/PinkTitle" android:text="@string/title_image_watermark"/>

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/title_line"
            android:layout_marginBottom="20dp"/>

        <Button android:id="@+id/btn_wm_pick" android:text="@string/file_enc_pick" style="@style/WhiteBtn"/>

        <ImageView
            android:id="@+id/iv_wm_preview"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="10dp"
            android:background="@color/white"
            android:scaleType="fitCenter"
            android:visibility="gone"/>

        <EditText
            android:id="@+id/et_wm_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/title_image_watermark"
            android:background="@color/white"
            android:padding="10dp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btn_wm_do"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/img_tool_watermark"
            style="@style/WhiteBtn"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</ScrollView>