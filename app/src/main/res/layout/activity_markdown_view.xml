<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_pink"
    android:padding="12dp">

    <TextView style="@style/PinkTitle" android:text="Markdown 预览"/>

    <View
        android:layout_width="60dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/title_line"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/et_md_input"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:hint="输 Markdown 或者选文件"
        android:gravity="top|start"
        android:background="@color/white"
        android:padding="10dp"
        android:inputType="textMultiLine"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_md_render"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="渲染"
            style="@style/WhiteBtn"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btn_md_pick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选文件"
            style="@style/WhiteBtn"
            android:layout_marginStart="6dp"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@color/white">

        <TextView
            android:id="@+id/tv_md_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textIsSelectable="true"/>

    </ScrollView>

</LinearLayout>