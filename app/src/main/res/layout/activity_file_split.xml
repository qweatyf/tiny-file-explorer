<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView style="@style/PinkTitle" android:text="文件切分/合并"/>

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/title_line"
            android:layout_marginBottom="20dp"/>

        <Button android:id="@+id/btn_split_pick" android:text="选文件" style="@style/WhiteBtn"/>

        <TextView
            android:id="@+id/tv_split_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="未选文件"
            android:textColor="@color/text"
            android:padding="10dp"
            android:ellipsize="middle"
            android:singleLine="true"/>

        <EditText
            android:id="@+id/et_split_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="每块大小 (KB)，默认 1024"
            android:inputType="number"
            android:background="@color/white"
            android:padding="12dp"
            android:layout_marginBottom="10dp"/>

        <Button android:id="@+id/btn_split_do" android:text="切分" style="@style/WhiteBtn"/>

        <Button
            android:id="@+id/btn_split_merge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="合并（点这里输目录）"
            style="@style/WhiteBtn"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:text="切分文件存到 Download/切分文件/"
            android:textSize="12sp"
            android:textColor="#888"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>