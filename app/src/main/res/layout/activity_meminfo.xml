<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_pink"
    android:padding="16dp">

    <TextView style="@style/PinkTitle" android:text="内存信息"/>

    <View
        android:layout_width="60dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/title_line"
        android:layout_marginBottom="20dp"/>

    <TextView android:id="@+id/tv_mem_total" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/text"
        android:textSize="16sp" android:padding="6dp"/>

    <TextView android:id="@+id/tv_mem_avail" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/text"
        android:textSize="16sp" android:padding="6dp"
        android:paddingBottom="10dp"/>

    <ListView
        android:id="@+id/lv_procs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:focusable="true"/>

    <Button android:id="@+id/btn_useless" android:text="没用的进程"
        style="@style/WhiteBtn" android:layout_marginTop="10dp"/>

</LinearLayout>