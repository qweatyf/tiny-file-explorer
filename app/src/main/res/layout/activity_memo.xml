<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_pink"
    android:padding="16dp">

    <TextView style="@style/PinkTitle" android:text="@string/memo_title"/>

    <View
        android:layout_width="60dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/title_line"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/et_memo_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/file_tool_search"
        android:background="@color/white"
        android:padding="10dp"
        android:singleLine="true"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btn_save_memo"
        android:text="@string/memo_save"
        style="@style/WhiteBtn"
        android:layout_marginBottom="10dp"/>

    <ListView
        android:id="@+id/lv_memo_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:divider="@null"/>

</LinearLayout>