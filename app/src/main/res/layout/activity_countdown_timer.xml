<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/PinkTitle" android:text="倒计时"/>

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/title_line"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="时" android:textColor="@color/text" android:paddingBottom="4dp"
                    android:gravity="center"/>

                <EditText
                    android:id="@+id/et_cdt_hour"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:background="@color/white"
                    android:padding="10dp"
                    android:gravity="center"
                    android:singleLine="true"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="分" android:textColor="@color/text" android:paddingBottom="4dp"
                    android:gravity="center"/>

                <EditText
                    android:id="@+id/et_cdt_min"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:background="@color/white"
                    android:padding="10dp"
                    android:gravity="center"
                    android:singleLine="true"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="秒" android:textColor="@color/text" android:paddingBottom="4dp"
                    android:gravity="center"/>

                <EditText
                    android:id="@+id/et_cdt_sec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:background="@color/white"
                    android:padding="10dp"
                    android:gravity="center"
                    android:singleLine="true"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_cdt_ring_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:background="@color/white"
            android:ellipsize="middle"
            android:singleLine="true"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button android:id="@+id/btn_cdt_pick_ring" android:text="选铃声"
                style="@style/WhiteBtn"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginEnd="4dp"/>

            <Button android:id="@+id/btn_cdt_reset_ring" android:text="默认铃声"
                style="@style/WhiteBtn"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btn_cdt_start"
            android:text="开始倒计时"
            style="@style/WhiteBtn"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="倒计时到点会响铃+通知，后台也生效"
            android:textSize="12sp"
            android:textColor="#888"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>