<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_pink"
    android:padding="20dp">

    <TextView style="@style/PinkTitle" android:text="文档工具箱"/>

    <View
        android:layout_width="60dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/title_line"
        android:layout_marginBottom="20dp"/>

    <Button android:id="@+id/btn_doc_md" android:text="Markdown 预览" style="@style/WhiteBtn"/>
    <Button android:id="@+id/btn_doc_csv" android:text="CSV 查看" style="@style/WhiteBtn"/>
    <Button android:id="@+id/btn_doc_enc" android:text="文本编码转换" style="@style/WhiteBtn"/>
    <Button android:id="@+id/btn_doc_pdf" android:text="PDF 合并" style="@style/WhiteBtn"/>

</LinearLayout>