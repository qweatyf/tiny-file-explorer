<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_pink"
    android:padding="16dp">

    <TextView style="@style/PinkTitle" android:text="@string/title_qr_scan"/>

    <View
        android:layout_width="60dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/title_line"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_qr_scan_cam"
            android:text="@string/title_qr_scan"
            style="@style/WhiteBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btn_qr_scan_pick"
            android:text="@string/file_enc_pick"
            style="@style/WhiteBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tv_qr_scan_result"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:padding="12dp"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:textIsSelectable="true"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btn_qr_scan_copy"
            android:text="@string/file_menu_copy"
            style="@style/WhiteBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btn_qr_scan_open"
            android:text="@string/title_qr_gen"
            style="@style/WhiteBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"/>

    </LinearLayout>

</LinearLayout>