<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_pink"
    android:padding="12dp">

    <TextView style="@style/PinkTitle" android:text="HTTP 请求"/>

    <View
        android:layout_width="60dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/title_line"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/sp_http_method"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:background="@color/white"/>

        <EditText
            android:id="@+id/et_http_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:hint="https://example.com"
            android:background="@color/white"
            android:padding="10dp"
            android:singleLine="true"
            android:inputType="textUri"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="请求头（每行一条 Key: Value）"
        android:textColor="@color/text"
        android:textSize="12sp"/>

    <EditText
        android:id="@+id/et_http_headers"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="top|start"
        android:background="@color/white"
        android:padding="10dp"
        android:textSize="12sp"
        android:inputType="textMultiLine"
        android:hint="Content-Type: application/json"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="请求体（POST / PUT 等用）"
        android:textColor="@color/text"
        android:textSize="12sp"/>

    <EditText
        android:id="@+id/et_http_body"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="top|start"
        android:background="@color/white"
        android:padding="10dp"
        android:textSize="12sp"
        android:inputType="textMultiLine"
        android:hint="{}"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button android:id="@+id/btn_http_send" android:text="发送"
            style="@style/WhiteBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginEnd="6dp"/>

        <Button android:id="@+id/btn_http_clear" android:text="清空"
            style="@style/WhiteBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginStart="6dp"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tv_http_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:typeface="monospace"/>

    </ScrollView>

</LinearLayout>