<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="20dp">

            <ImageView
                android:id="@+id/btn_help"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_help"
                android:background="@drawable/circle_bg"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="小型文件管理器"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/main_pink"
                android:gravity="center"/>
        </LinearLayout>

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/title_line"
            android:layout_marginBottom="30dp"/>

        <LinearLayout android:id="@+id/btn_func" style="@style/CardBtn">
            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_func"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="功能" android:textSize="20sp"
                android:textStyle="bold" android:textColor="@color/text" android:paddingStart="20dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/btn_encrypt" style="@style/CardBtn">
            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_encrypt"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="加密" android:textSize="20sp"
                android:textStyle="bold" android:textColor="@color/text" android:paddingStart="20dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/btn_game" style="@style/CardBtn">
            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_game"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="游戏" android:textSize="20sp"
                android:textStyle="bold" android:textColor="@color/text" android:paddingStart="20dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/btn_mine" style="@style/CardBtn">
            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_mine"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="我的" android:textSize="20sp"
                android:textStyle="bold" android:textColor="@color/text" android:paddingStart="20dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>