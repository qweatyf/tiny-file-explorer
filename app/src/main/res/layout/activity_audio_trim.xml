<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_pink"
    android:padding="20dp">

    <TextView style="@style/PinkTitle" android:text="@string/title_audio_trim"/>

    <View
        android:layout_width="60dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/title_line"
        android:layout_marginBottom="20dp"/>

    <Button android:id="@+id/btn_at_pick" android:text="@string/file_enc_pick" style="@style/WhiteBtn"/>

    <TextView
        android:id="@+id/tv_at_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/file_enc_none"
        android:textColor="@color/text"
        android:padding="10dp"
        android:ellipsize="middle"
        android:singleLine="true"/>

    <EditText
        android:id="@+id/et_at_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:background="@color/white"
        android:padding="10dp"/>

    <EditText
        android:id="@+id/et_at_end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:background="@color/white"
        android:padding="10dp"
        android:layout_marginTop="6dp"/>

    <Button
        android:id="@+id/btn_at_do"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/media_tool_trim"
        style="@style/WhiteBtn"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btn_at_set_alarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/alarm_pick_ring"
        style="@style/WhiteBtn"
        android:enabled="false"
        android:layout_marginTop="10dp"/>

</LinearLayout>