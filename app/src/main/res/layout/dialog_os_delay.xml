<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#1A1A1A">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/binary_os_delay_title"
        android:textColor="#00FF00"
        android:textSize="16sp"
        android:typeface="monospace"
        android:paddingBottom="12dp"/>

    <EditText
        android:id="@+id/et_os_delay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:text="3000"
        android:textColor="#00FF00"
        android:background="#333333"
        android:padding="12dp"
        android:typeface="monospace"
        android:layout_marginBottom="12dp"/>

    <CheckBox
        android:id="@+id/cb_os_unlimited"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/binary_os_delay_unlimited"
        android:textColor="#00FF00"
        android:buttonTint="#00FF00"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btn_os_agree"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/binary_os_delay_agree"
        android:textColor="#00FF00"
        android:background="#333333"
        android:textSize="16sp"
        android:typeface="monospace"/>

</LinearLayout>