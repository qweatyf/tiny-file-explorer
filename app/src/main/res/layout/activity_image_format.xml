<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_pink"
    android:padding="12dp">

    <TextView style="@style/PinkTitle" android:text="图片转格式"/>

    <View
        android:layout_width="60dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/title_line"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn_fmt_pick"
            android:text="选图片（可多选）"
            style="@style/WhiteBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_fmt_do"
            android:text="选格式并转"
            style="@style/WhiteBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <GridView
        android:id="@+id/gv_fmt_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="3"
        android:horizontalSpacing="4dp"
        android:verticalSpacing="4dp"
        android:stretchMode="columnWidth"
        android:background="@color/white"
        android:padding="4dp"/>

    <TextView
        android:id="@+id/tv_fmt_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:textColor="@color/text"
        android:textSize="13sp"
        android:gravity="center"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="最多 100 张，支持 PNG / JPEG / WEBP / BMP / GIF"
        android:textSize="12sp"
        android:textColor="#888"
        android:gravity="center"/>

</LinearLayout>